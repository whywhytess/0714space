# .env.example — 变量名模板（仅 LOCAL 使用）
# 规则：只写变量名，不写任何真实值。复制为 .env 后填本地 dummy 值。
# .env 已被 .gitignore 忽略；production 使用 Secret Manager，见 docs/security/secret-policy.md

# --- 运行环境 ---
APP_ENV=

# --- 域名（占位，见 open-decisions D-01）---
PLATFORM_BASE_DOMAIN=
SITE_BASE_DOMAIN=

# --- PostgreSQL ---
DATABASE_URL=
DATABASE_PASSWORD=

# --- Redis（三域分离，见 ADR-0003）---
REDIS_AUTH_URL=
REDIS_CACHE_URL=
REDIS_QUEUE_URL=
REDIS_PASSWORD=

# --- 对象存储（S3 兼容 / MinIO）---
OBJECT_STORAGE_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# --- 签名 / 会话 ---
SESSION_SIGNING_KEY=

# --- 邮件 ---
EMAIL_API_KEY=

# --- 自定义域名 / DNS（生产为红线，不给 AI）---
DNS_API_TOKEN=

# --- 自动 TLS / ACME（CA 私钥为红线，不给 AI）---
ACME_EMAIL=
ACME_ACCOUNT_KEY=

# --- 计费 / Webhook（生产为红线）---
PAYMENT_SECRET=
WEBHOOK_SECRET=
